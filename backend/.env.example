# The existing PostgreSQL database; schema ownership and migrations stay with lxlleague.
DATABASE_URL=postgresql://admin_service:replace-me@127.0.0.1:5432/lxlleague
# Generate an independent value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=
ADMIN_API_PORT=3001
# Shared asset catalogue (music, rank icons, champion data, etc.), read only.
ASSET_DIR=/srv/lxl-assets
# Shared writable media storage, or configure the same OSS bucket below.
UPLOAD_DIR=/srv/lxl-uploads
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=
OSS_PREFIX=
FFMPEG_PATH=ffmpeg
