[Unit]
Description=LXL independent management backend
Wants=network-online.target lxl-admin-db-tunnel.service
After=network-online.target lxl-admin-db-tunnel.service

[Service]
Type=simple
User=lxl-admin
Group=lxl-admin
WorkingDirectory=/opt/lxlleague-admin/backend-current
EnvironmentFile=/etc/lxl-admin/backend.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3001
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lxl-uploads
UMask=0077

[Install]
WantedBy=multi-user.target
